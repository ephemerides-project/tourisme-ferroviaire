# Copier ce fichier en « .env » à la racine du projet, puis adapter.
# Toutes les valeurs ont un défaut : sans fichier .env, l'application fonctionne sans LLM.

# --- Base de données ---
DATABASE_URL=postgresql://tourisme:tourisme@localhost:5432/tourisme

# Base réservée aux tests automatiques. Son contenu est EFFACÉ à chaque exécution de pytest :
# ne jamais y mettre l'adresse de la base ci-dessus.
# DATABASE_URL_TEST=postgresql://tourisme:tourisme@localhost:5432/tourisme_test

# --- Périmètre ---
# Départements chargés. Réduire la liste accélère l'ingestion (ex. 38,73,74 pour Isère et Savoies).
DEPARTEMENTS=01,03,07,15,26,38,42,43,63,69,73,74
ORIGINE_PAR_DEFAUT=Grenoble
# 2 = trains seulement ; 2,3 = trains et cars
TYPES_ROUTE_GTFS=2

# --- LLM (facultatif) ---
# Toute API compatible « OpenAI chat completions ». Laisser vide pour fonctionner sans LLM.
#
# Exemple en local avec Ollama (après « ollama pull <modèle> ») :
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=mistral
#
# Exemple avec un fournisseur cloud : adresse de son API compatible, nom du modèle, clé.
# (Adresse et nom de modèle donnés à titre d'illustration : à vérifier dans la documentation du fournisseur.)
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
# LLM_API_KEY=...
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=30

# --- Interface ---
CORS_ORIGINES=http://localhost:3000
